# ==========================================
# Mod of Us Server & Discord Bot Configuration
# ==========================================

# Server Settings
ADDR=:8180
PATH_PREFIX=/api
BASE_PATH=/v1
TZ=Asia/Tokyo

# PostgreSQL Database
DATABASE_URL=postgres://postgres:password@localhost:5432/au_mod_installer?sslmode=disable

# S3-compatible Storage (SeaweedFS / Cloudflare R2 / AWS S3)
# For local SeaweedFS via docker compose:
S3_ENDPOINT=http://localhost:8333
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=au-mods
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_USE_PATH_STYLE=true

# Discord Bot Settings
DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_MOD_ROLE_ID=
DISCORD_REVIEW_CHANNEL_ID=
DISCORD_SHOWCASE_FORUM_ID=
DISCORD_UPDATES_CHANNEL_ID=
DISCORD_REPORT_CHANNEL_ID=
DISCORD_AUDIT_LOG_CHANNEL_ID=

# Security & Scanning (Optional)
VIRUSTOTAL_API_KEY=
